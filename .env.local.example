# ── OpenAI API (GPT-4o-mini 번역용) ─────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
# 이 파일을 복사해서 .env.local 로 이름 바꾸고 키를 입력하세요
OPENAI_API_KEY=

# ── Google API (세미나 동기화용) ─────────────────────────────────
# 서비스 계정 JSON 키 경로
GOOGLE_CREDENTIALS_PATH=
# 02_세미나 폴더 ID
SEMINAR_FOLDER_ID=
# Seminar_Paper_List 스프레드시트 ID
PAPER_LIST_SHEET_ID=
# 위 시트 내 대상 탭 gid
PAPER_LIST_SHEET_GID=

NOTION_API_KEY=
NOTION_TODO_PARENT_PAGE_ID=
